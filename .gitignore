# Node / frontend
node_modules/
dist/
.vite/
*.local

# Rust / Tauri
src-tauri/target/
# Each crate under crates/ is a standalone (non-workspace) cargo project, so building or testing one
# drops its own target/ next to its Cargo.toml. Build output, never source.
crates/*/target/
src-tauri/gen/schemas/

# Local status dashboard (regenerated by scheduled task)
STATUS.html

# Cipher MCP server runtime state (local session DB — not source)
data/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets — NEVER commit signing keys
*.key
*.key.pub
updater.pw
.env
.env.*
# Exception: throwaway DEMO-ONLY crypto sample fixtures (CPE-1425) — intentionally committed,
# never a real credential.
!samples/crypto/*.key

# Sub-agent worktrees (transient; never commit)
.claude/worktrees/

# CPE-1884: headless-chrome user-data-dirs scripts/dev-harness/sidebar-drop-stack-overlap/check.mjs
# (and future real-browser layout harnesses in the same spirit) spin up per-run — transient, never commit.
.claude/dev-harness-chrome-profiles/

# UAT scratch directories (transient; never commit) — CPE-1697: a UAT scratch dir committed by
# mistake produced two full duplicate copies of the repo tree (.claude/uat-1025/, .claude/uat-1025b/,
# 3,186 files). This pattern catches the next one at `git add` time instead of a reviewer months later.
.claude/uat-*/

# Sprint raw per-agent metrics (transient/noisy; the distilled history.md IS committed)
.claude/sprint-metrics/ledger.jsonl
# Sprint concurrency lock (per-machine, transient; never committed)
.claude/sprint-metrics/SPRINT-LOCK

# Generated catalog bundle (produced by CI / catalog-sign)
catalog-out/

# Bundled sidecar binary staged for release (built in CI / locally)
src-tauri/sidecars/

# Downloaded/compiled pdfium + ffmpeg native deps staged for the sidecar release bundle (CPE-1258) —
# ephemeral CI download/build output, never committed.
native-deps/
.aider*

# Swarm how-to-demo output files created when running demos in the repo folder (CPE-954/956)
*-DEMO.md

# CPE-1042: git-ignored sandbox for editable copies of samples/ (scripts/new-sample-sandbox.*)
.sandbox/
*.pfx
*.p12
.claude/sprint-metrics/BATCH-COUNTER

# CPE-1872 round-2 security-audit finding 3: tauri-action writes the updater manifest to the repo
# root (resolve(process.cwd(), 'latest.json')) during a release build and never commits it -- but
# nothing previously forbade a stray copy from being committed by accident, which would survive
# actions/checkout and could confuse anything that reads a repo-root latest.json by default. Never
# committed; release.yml also `rm -f`s it immediately before each build for defense in depth.
/latest.json
