# Node / frontend
node_modules/
dist/
.vite/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas/

# Local status dashboard (regenerated by scheduled task)
STATUS.html

# Cipher MCP server runtime state (local session DB — not source)
data/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets — NEVER commit signing keys
*.key
*.key.pub
updater.pw
.env
.env.*

# Sub-agent worktrees (transient; never commit)
.claude/worktrees/

# Workshift raw per-agent metrics (transient/noisy; the distilled history.md IS committed)
.claude/workshift-metrics/ledger.jsonl
# Workshift concurrency lock (per-machine, transient; never committed)
.claude/workshift-metrics/WORKSHIFT-LOCK

# Generated catalog bundle (produced by CI / catalog-sign)
catalog-out/

# Bundled sidecar binary staged for release (built in CI / locally)
src-tauri/sidecars/
.aider*

# Swarm how-to-demo output files created when running demos in the repo folder (CPE-954/956)
*-DEMO.md

# CPE-1042: git-ignored sandbox for editable copies of samples/ (scripts/new-sample-sandbox.*)
.sandbox/
*.pfx
*.p12
